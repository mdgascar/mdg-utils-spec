{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdgascar/mdg-utils-spec/modules/date/schema.json",
  "title": "Malagasy calendar names and date patterns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "months",
    "monthsSource",
    "weekdays",
    "weekdaysSource",
    "styles",
    "limits",
    "time",
    "fractions",
    "fractionsSource",
    "dayParts",
    "dayPartsSource"
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][a-z]+$"
    },
    "sourced": {
      "$ref": "../../schemas/source.schema.json"
    }
  },
  "properties": {
    "months": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "abbreviation"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "abbreviation": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "monthsSource": {
      "$ref": "#/$defs/sourced",
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "source": true,
        "checked": true
      }
    },
    "weekdays": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["isoNumber", "name", "abbreviation"],
        "properties": {
          "isoNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "abbreviation": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "weekdaysSource": {
      "$ref": "#/$defs/sourced",
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "source": true,
        "checked": true
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/sourced"
          }
        ],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "pattern"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "pattern": {
            "type": "string",
            "pattern": "^(EEEE|MMMM|MMM|MM|dd|d|y|[ /.,-])+$"
          },
          "source": true,
          "checked": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minYear", "maxYear", "maxReadLength", "maxTimeReadLength"],
      "properties": {
        "minYear": {
          "type": "integer",
          "minimum": 1
        },
        "maxYear": {
          "type": "integer",
          "maximum": 9999
        },
        "maxReadLength": {
          "type": "integer",
          "minimum": 1
        },
        "maxTimeReadLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "time": {
      "allOf": [
        {
          "$ref": "../../schemas/source.schema.json"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["prefix", "after", "before", "more"],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[a-z' ]+$"
        },
        "after": {
          "type": "string",
          "pattern": "^[a-z' ]+$"
        },
        "before": {
          "type": "string",
          "pattern": "^[a-z' ]+$"
        },
        "more": {
          "type": "string",
          "pattern": "^[a-z' ]+$"
        },
        "source": true,
        "checked": true
      }
    },
    "fractions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minutes", "word"],
        "properties": {
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "word": {
            "type": "string",
            "pattern": "^[a-z' ]+$"
          }
        }
      }
    },
    "fractionsSource": {
      "$ref": "../../schemas/source.schema.json"
    },
    "dayParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "word"],
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "to": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "word": {
            "type": "string",
            "pattern": "^[a-z' ]+$"
          }
        }
      }
    },
    "dayPartsSource": {
      "$ref": "../../schemas/source.schema.json"
    }
  }
}
